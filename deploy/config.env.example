# Compose configuration only. No passwords, database URLs or provider tokens.
# Context paths are relative to the directory containing compose.staging.yml.
RESTAURANT_CONTEXT=..
ARCADE_CONTEXT=../../arcade
REZZO_CONTEXT=../../rezzo

# Replace these reserved example domains with three configured HTTPS origins.
# Use exact origins: no trailing slash, path, query, credentials or wildcard.
RESTAURANT_PUBLIC_URL=https://restaurant-preview.example.com
ARCADE_PUBLIC_URL=https://arcade-preview.example.com
REZZO_PUBLIC_URL=https://booking-preview.example.com

# These host ports stay bound to 127.0.0.1.
RESTAURANT_PORT=7344
ARCADE_PORT=7343
REZZO_PORT=7341
